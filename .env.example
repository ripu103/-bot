# =====================================================================
# りぷSHOP 自販機UI / Discord Bot 連携用 環境変数（ひな形）
# 実際に使うときはこのファイルを .env にコピーして値を入力してください。
# =====================================================================

# --- Discord アプリケーション ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# コマンドを登録するサーバーID（空欄ならグローバル登録）
DISCORD_GUILD_ID=

# --- 権限 ---
# 許可ロール（鯖主）。/shopチャンネル作成 で自動作成・登録されます
DISCORD_ALLOWED_ROLE_ID=

# --- データベース ---
# SQLiteファイル。RenderではPersistent Diskを /data にマウントして /data/rip-shop.db を指定
DATABASE_PATH=data/rip-shop.db

# --- 購入設定 ---
PURCHASE_MAX_QUANTITY=10

# --- バックアップ ---
BACKUP_INTERVAL_DAYS=3
BACKUP_KEEP=3

# --- 通知・ログ ---
DISCORD_NOTIFY_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DISCORD_SIGNATURE_TOLERANCE_SECONDS=300

# --- 既存システム（Render）の接続先 ---
RENDER_API_BASE_URL=
RENDER_API_TOKEN=
RENDER_PRODUCTS_PATH=/api/products
RENDER_PURCHASE_PATH=/api/purchase
RENDER_STOCK_PATH=

# --- 表示設定 ---
VENDING_MACHINE_NAME=りぷSHOP 自販機
BRAND_LOGO_URL=

# --- サーバー ---
PORT=3001
